# Copy to .env.local for local development. Never commit a real key.
# Every value below belongs to an account owned by The GIA Foundation.

# --- Site ---------------------------------------------------------------
# Public base URL. Locally this is http://localhost:3000; in production it is
# the foundation's domain. Vercel preview deploys fall back to the request
# origin, so this can be left unset there.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Donations ----------------------------------------------------------
# Leave as "false" until the foundation's Stripe account is live. While false
# the donate page shows contact details instead of a payment form.
NEXT_PUBLIC_DONATIONS_ENABLED=false

# Server-side only. Must never be prefixed NEXT_PUBLIC_ — that would ship it
# to the browser. Use a test key (sk_test_...) everywhere except production.
STRIPE_SECRET_KEY=

# Signing secret for the Stripe webhook endpoint, once one is added.
STRIPE_WEBHOOK_SECRET=
